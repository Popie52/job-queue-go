# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jobqueue

# Full connection string (used by the app)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobqueue?sslmode=disable

# Worker pool
WORKER_COUNT=5

# Visibility timeout — inflight jobs past this are re-queued (e.g. 30s, 1m)
VISIBILITY_TIMEOUT=30s

# HTTP server port
PORT=8080
